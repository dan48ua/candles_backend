generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model order_products {
  id         String  @id @unique @default(cuid())
  order_id   String
  quantity   Int
  amount     Int
  product_id String
  order      order   @relation(fields: [order_id], references: [id])
  product    product @relation(fields: [product_id], references: [id])
}

model basket {
  id         String  @id @unique @default(cuid())
  quantity   Int
  amount     Int
  product_id String
  user_id    String
  product    product @relation(fields: [product_id], references: [id])
  user       user    @relation(fields: [user_id], references: [id])
}

model order {
  id             String           @id(map: "Order_pkey") @unique(map: "Order_id_key") @default(cuid())
  number         String
  userId         String
  createdAt      DateTime         @default(now())
  user           user             @relation(fields: [userId], references: [id], map: "Order_userId_fkey")
  order_products order_products[]
}

model product {
  id             String           @id(map: "Product_pkey") @unique(map: "Product_id_key") @default(cuid())
  name           String           @unique(map: "Product_name_key")
  price          Int
  description    String?
  basket         basket[]
  order_products order_products[]
}

model user {
  id        String   @id(map: "users_pkey") @unique(map: "users_id_key") @default(cuid())
  email     String   @unique(map: "users_email_key")
  name      String
  password  String
  createdAt DateTime @default(now())
  phone     String   @unique(map: "users_phone_key")
  basket    basket[]
  order     order[]
}
